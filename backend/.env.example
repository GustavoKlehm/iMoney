# Supabase PostgreSQL — pegue em: Project Settings > Database > Connection string (URI)
# Use a connection string com pooling para produção (porta 6543) e direct para migrations (porta 5432)
# IMPORTANTE: se a senha tiver caracteres especiais (# @ : / etc.), encode na URL:
#   # → %23   @ → %40   : → %3A   / → %2F
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth — pegue em: Project Settings > API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[ANON_KEY]"

# Servidor local
PORT=3001

# Frontend (CORS)
FRONTEND_URL="http://localhost:5173"

# Ambiente
NODE_ENV=development
